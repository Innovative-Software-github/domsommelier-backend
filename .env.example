# ─── MinIO object storage ────────────────────────────────────────────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme
MINIO_API_PORT=9000
MINIO_WEB_PORT=9001
MINIO_DOMAIN=minio
MINIO_ACCESS_NAME=<your-access-key>
MINIO_ACCESS_SECRET=<your-secret-key>

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
POSTGRES_DOMAIN=db
POSTGRES_DB=domsommelier

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_DOMAIN=redis

# ─── API app ──────────────────────────────────────────────────────────────────
API_PORT=8080

# ─── Reverse proxy ────────────────────────────────────────────────────────────
REVERSE_PROXY_PORT=80

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=<app-password>
MAIL_PROTOCOL=smtps

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<at-least-32-chars-random-string>

# ─── Spring profiles ──────────────────────────────────────────────────────────
# Local dev:  SPRING_PROFILES_ACTIVE=docker          (create-drop + seed)
# Production: SPRING_PROFILES_ACTIVE=docker,prod     (update, no seed)
SPRING_PROFILES_ACTIVE=docker
