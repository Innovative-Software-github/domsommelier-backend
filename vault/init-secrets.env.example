# ============================================
# Vault Init Secrets (OPTIONAL)
# ============================================
# This file auto-populates Vault on first run.
# If you prefer to add secrets via Vault UI (http://localhost:8200),
# you can skip this file entirely — just run:
#   docker compose up vault
# and follow the instructions in vault-init logs.
#
# To use this file: copy to vault/init-secrets.env, fill in values, run docker compose up.
# IMPORTANT: Do NOT commit vault/init-secrets.env to git!
# ============================================

# ── Database ──
DB_USER="postgres"
DB_PASSWORD="change-me-strong-password"
DB_NAME="domsommelier"

# ── MinIO ──
MINIO_ROOT_USER="admin"
MINIO_ROOT_PASSWORD="change-me-minio-password"
MINIO_ACCESS_NAME="change-me-access-key"
MINIO_ACCESS_SECRET="change-me-secret-key"

# ── Email (Yandex SMTP) ──
MAIL_HOST="smtp.yandex.ru"
MAIL_PORT="465"
MAIL_USERNAME="your-email@yandex.ru"
MAIL_PASSWORD="your-app-password"
MAIL_PROTOCOL="smtps"

# ── JWT ──
JWT_SECRET="change-me-long-random-jwt-secret-key"
